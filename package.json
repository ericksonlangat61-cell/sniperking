    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ws": "^8.14.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "mongoose": "^7.5.0",
    "nodemon": "^3.0.1",
    "axios": "^1.5.0",
    "node-cache": "^5.1.2"
  }
}
