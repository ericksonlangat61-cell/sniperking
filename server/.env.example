# Deriv API
DERIV_APP_ID=1089

# Admin (NO HARDCODED PASSWORDS - USE ENV VARS ONLY)
ADMIN_USER=manu
ADMIN_PASS=your_secure_password_here

# Server
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_key_min_32_chars_change_in_production

# Database
MONGODB_URI=mongodb://localhost:27017/sniperking

# Client
CLIENT_URL=http://localhost:3000

# WebSocket
WS_ENDPOINT=wss://ws.derivws.com/websockets/v3
WS_ENDPOINT_FALLBACK=wss://ws.binaryws.com/websockets/v3
